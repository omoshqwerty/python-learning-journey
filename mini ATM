# This is a mini ATM project

account = {
    "name": "David",
    "pin": "1234",
    "balance": 0
}

pin = input("Enter your pin: ")
if pin == account["pin"]:
    while True:
        print("1. Check balance.")
        print("2. Save money.")
        print("3. Withdraw.")
        print("4. check details")
        print("5. Exit.")

        choice = input("Enter your choice in 1/2/3/4: ")
        if choice == "1":
            print(f"Balance is Ksh.{account["balance"]:.2f}")
        elif choice == "2":
            try:
                amount = float(input("Enter amount to save: "))
                if amount <= 0:
                    print("Invalid amount!")
                    continue
                account["balance"] += amount
                print(f"Ksh.{amount} added succesfully!")
                print(f"New balance is {account['balance']}")
            except ValueError:
                print("Invalid input!, Please enter a number!")
        elif choice == "3":
            try:
                amount = float(input("Enter amount to withdraw: "))
                if amount <= 0:
                    print("Invalid amount!")
                    continue
                account["balance"] -= amount
                print(f"Ksh.{amount} withdrawn succesfully!")
                print(f"New balance is {account['balance']}")
            except ValueError:
                print("Invalid input!, Please enter a number!")  

        elif choice == "4":
            print(f"Name: {account['name']} \nBalance: {account['balance']}")

        elif choice == "5":
            print("Thanks for using our ATM!")
            break
        else:
            print("Invalid choice!, Try again!")
            continue
else:
    print("Invalid pin try again!")


